# Create a free account at https://worldfeedmonitor.com/register, then
# Dashboard -> API Credentials -> New. The secret is shown once: copy it then.
WFM_API_KEY=your-api-key
WFM_API_SECRET=your-api-secret

# Optional. Defaults to the production API.
# WFM_API_URL=https://api.worldfeedmonitor.com/v1
